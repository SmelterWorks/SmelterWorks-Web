{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "vintage-story-worldmap",
    "version": "1.0.0",
    "description": "Procedural pixel-art world map tiles from real coastline data, in a Vintage Story palette. Framework-agnostic core plus an optional OpenLayers tile source.",
    "license": "MIT",
    "type": "module",
    "main": "./index.js",
    "exports": {
        ".": "./index.js",
        "./openlayers": "./openlayers.js"
    },
    "sideEffects": false,
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "generate-land-mask": "node scripts/generate-land-mask.mjs",
        "generate-koppen-mask": "node scripts/generate-koppen-mask.mjs"
    },
    "peerDependencies": {
        "ol": "^10.0.0"
    },
    "peerDependenciesMeta": {
        "ol": {
            "optional": true
        }
    },
    "devDependencies": {
        "d3-geo": "^3.1.1",
        "ol": "^10.10.0",
        "topojson-client": "^3.1.0",
        "world-atlas": "^2.0.2"
    }
}
