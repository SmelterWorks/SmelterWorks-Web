{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "icons:sync": "node scripts/sync-icons.mjs",
        "build": "npm run icons:sync && vite build",
        "dev": "vite",
        "format": "blade-formatter --write \"resources/views/**/*.blade.php\"",
        "format:check": "blade-formatter --check-formatted \"resources/views/**/*.blade.php\"",
        "lint": "npm run format:check"
    },
    "devDependencies": {
        "@fortawesome/fontawesome-free": "^7.3.1",
        "@tailwindcss/vite": "^4.0.0",
        "blade-formatter": "^1.44.4",
        "concurrently": "^10.0.4",
        "country-flag-icons": "^1.6.20",
        "laravel-vite-plugin": "^3.1",
        "lucide-static": "^1.28.0",
        "simple-icons": "^16.28.0",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    }
}
