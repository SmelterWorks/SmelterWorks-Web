APP_NAME=SmelterWorks
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
# Production behind Coolify must be https://your.domain (scheme included).
# Asset URLs, Vite tags, and canonicals follow APP_URL.

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Optional public links. Leave blank to hide. Do not commit production invites or secrets.
SMELTERWORKS_FLUXER_URL=
SMELTERWORKS_FORGEJO_URL=https://git.smelterworks.com/smelter
SMELTERWORKS_GITHUB_URL=https://github.com/SmelterWorks
SMELTERWORKS_RELIC_REPO_URL=https://git.smelterworks.com/smelter/Relic-Launcher
SMELTERWORKS_RELIC_RELEASES_REPO_URL=https://github.com/SmelterWorks/Relic-Launcher
# Optional Forgejo source URL when GitHub API is rate limited. Defaults to {SMELTERWORKS_FORGEJO_URL}/Relic-Launcher.
SMELTERWORKS_RELIC_FORGEJO_REPO_URL=
# Optional GitHub token for higher API rate limits on release lookups.
SMELTERWORKS_GITHUB_TOKEN=
# Product update mirror (manifests + cached binaries). See config/smelterworks/updates.php.
SMELTERWORKS_UPDATES_PUBLIC_BASE_URL=
SMELTERWORKS_UPDATES_DISK=local
SMELTERWORKS_UPDATES_MAX_ASSET_BYTES=524288000
SMELTERWORKS_UPDATES_WARM_LOCK_SECONDS=600
SMELTERWORKS_UPDATES_WARM_INTERVAL_MINUTES=30
SMELTERWORKS_UPDATES_CACHE_SECONDS=3600
SMELTERWORKS_UPDATES_STALE_SECONDS=86400
SMELTERWORKS_UPDATES_USE_ACCEL_REDIRECT=true
# USD to EUR on hosting. Stale copy kept when Frankfurter is down. Fallback when cache is empty.
SMELTERWORKS_EXCHANGE_CACHE_SECONDS=21600
SMELTERWORKS_EXCHANGE_STALE_SECONDS=604800
SMELTERWORKS_EXCHANGE_FALLBACK_USD_TO_EUR=0.92
# Blank uses GitHub {releases_repo}/releases/latest when a stable release exists.
SMELTERWORKS_RELIC_RELEASES_URL=
# Show nightly pre-release section on /relic/download (GitHub nightly-YYYYMMDD tags).
SMELTERWORKS_RELIC_NIGHTLY_ENABLED=true
SMELTERWORKS_PANEL_URL=
SMELTERWORKS_WIKI_URL=
SMELTERWORKS_LEGAL_CONTACT=
SMELTERWORKS_CONTACT_EMAIL=team@smelterworks.com
SMELTERWORKS_KOFI_URL=https://ko-fi.com/smelterworks
# Optional @handle for twitter:site. Leave blank to omit.
SMELTERWORKS_TWITTER=
# Blank uses a bundled WebP screenshot. Set a full URL to override.
SMELTERWORKS_RELIC_PREVIEW_URL=

# Vintage Story public server list proxy (Relic + /servers page).
SMELTERWORKS_SERVERS_BASE_URL=https://masterserver.vintagestory.at
SMELTERWORKS_SERVERS_LIST_PATH=/api/v1/servers/list
SMELTERWORKS_SERVERS_CACHE_SECONDS=120
SMELTERWORKS_SERVERS_STALE_SECONDS=604800
SMELTERWORKS_SERVERS_HTTP_TIMEOUT=15
SMELTERWORKS_SERVERS_MAX_BYTES=8388608
SMELTERWORKS_SERVERS_USER_AGENT=SmelterWorks-Web
SMELTERWORKS_SERVERS_OFFICIAL_URL=https://servers.vintagestory.at/

# Slim site banner under the navbar. Set SMELTERWORKS_BANNER_ENABLED=false to hide.
SMELTERWORKS_BANNER_ENABLED=false
SMELTERWORKS_BANNER_MESSAGE="Website is under construction"
SMELTERWORKS_BANNER_BACKGROUND=#b45309
SMELTERWORKS_BANNER_COLOR=#ffffff
SMELTERWORKS_BANNER_HREF=
SMELTERWORKS_BANNER_LINK_LABEL=
